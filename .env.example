# Copie ce fichier en .env.local et remplis les valeurs (Supabase > Project Settings > API Keys).
# Ne commite jamais .env.local.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique : "publishable key" (sb_publishable_...) ou l'ancienne clé "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clé serveur : "secret key" (sb_secret_...) ou l'ancienne clé "service_role".
# Utilisée uniquement par les routes API. NE JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : URL publique du site (liens de confirmation d'email).
# Par défaut, déduite de la requête.
# NEXT_PUBLIC_SITE_URL=https://skyboard.vercel.app

# Secret serveur pour dériver le nom (non devinable) du canal Realtime de chaque
# cockpit. 32 caractères min. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIEWER_CHANNEL_SECRET=change-me-with-a-long-random-string-0000000000
